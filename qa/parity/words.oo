// # Parity Words - The Word Codec Of The Case Table
//
// Logline: Writes one argument for the case table and reads a line of the case table back into arguments.
//
// Setup: Pure functions. No caps. No IO.
//
// Beats:
//   1. Write one argument so that the reader reads it back as it was.
//   2. Read one line of the table and split it into arguments.
//   3. Quote one argument so that the shell reads it as one plain word.
//   4. Split a text into its lines.
//   5. Remove the spaces and the tabs at both ends of a text.
//
// The case table holds arguments, and an argument may hold a space, a quote or
// a backslash. The table is a data file, so the writer and the reader must
// agree on one encoding. The encoding is the JSON string encoding: a word that
// holds no space, no tab, no double quote and no backslash is written as it
// is, and every other word is written in double quotes, where a backslash is
// written twice and a double quote is written with a backslash in front of it.
// A single quote is written as it is, because it has no meaning inside double
// quotes.
//
// The reader is the exact inverse of the writer. A quoted word ends at the
// double quote that is not escaped, and a backslash takes the character behind
// it as it is.
//
// This page is the one place that holds the codec. The generator writes the
// table with parity_quote_word and the runner reads it with parity_words, so
// the two can never drift apart.

// Write one argument so that the reader of the case table reads it back as it
// was written. A word with a space, a tab, a double quote or a backslash goes
// into double quotes, where a backslash is written twice and a double quote is
// written with a backslash in front of it.
pub fn parity_quote_word(word: String) -> String {
    if word == "" { return "\"\""; }
    let n: Int = chars_len(word);
    let mut i: Int = 0;
    let mut plain: Bool = true;
    while i < n {
        let c: String = char_at(word, i);
        if c == " " || c == "\t" || c == "\"" || c == "\\" { plain = false; break; }
        i = i + 1;
    }
    if plain { return word; }
    let mut out: String = "\"";
    i = 0;
    while i < n {
        let c: String = char_at(word, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else { out = out + c; }
        i = i + 1;
    }
    return out + "\"";
}

// Find where a quoted word ends. The word starts at the double quote at the
// given place, and the answer is the place of the closing double quote.
fn parity_word_quote_end(line: String, from: Int) -> Int {
    let n: Int = chars_len(line);
    let mut i: Int = from + 1;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\\" { i = i + 2; continue; }
        if c == "\"" { return i; }
        i = i + 1;
    }
    return n;
}

// Read the content of a quoted word and take the escapes out of it. A
// backslash stands for the character behind it.
fn parity_word_unquote(body: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(body);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(body, i);
        if c == "\\" && i + 1 < n {
            out = out + char_at(body, i + 1);
            i = i + 2;
            continue;
        }
        out = out + c;
        i = i + 1;
    }
    return out;
}

// Read one line of the case table and split it into arguments. A quoted word
// ends at the double quote that is not escaped, and a backslash takes the
// character behind it as it is.
pub fn parity_words(line: String) -> List[String] {
    let mut parts: List[String] = list_new();
    let mut cur: String = "";
    let mut has: Bool = false;
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\"" {
            let end: Int = parity_word_quote_end(line, i);
            cur = cur + parity_word_unquote(str_slice(line, i + 1, end));
            has = true;
            i = end + 1;
            continue;
        }
        if c == " " || c == "\t" {
            if has { parts = list_push(parts, cur); cur = ""; has = false; }
            i = i + 1;
            continue;
        }
        cur = cur + c;
        has = true;
        i = i + 1;
    }
    if has { parts = list_push(parts, cur); }
    return parts;
}

// Wrap a word in single quotes so the shell reads it as one plain word.
pub fn parity_quote(s: String) -> String {
    let mut quoted: String = "'";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" { quoted = quoted + "'\\''"; } else { quoted = quoted + c; }
        i = i + 1;
    }
    return quoted + "'";
}

// Split a file into lines.
pub fn parity_lines(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\n" {
            out = list_push(out, cur);
            cur = "";
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    out = list_push(out, cur);
    return out;
}

// Remove the spaces and the tabs at both ends of a string.
pub fn parity_trim(s: String) -> String {
    let n: Int = chars_len(s);
    let mut start: Int = 0;
    while start < n {
        let c: String = char_at(s, start);
        if c != " " && c != "\t" { break; }
        start = start + 1;
    }
    let mut end: Int = n;
    while end > start {
        let c: String = char_at(s, end - 1);
        if c != " " && c != "\t" { break; }
        end = end - 1;
    }
    if end <= start { return ""; }
    return str_slice(s, start, end);
}
